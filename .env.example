# Copy to .env.local and fill in real values. Never commit real secrets.
# Server-only secrets (never prefix with NEXT_PUBLIC_):
API_KEY=
WEBHOOK_SECRET=
# Anthropic (Claude) key for the AI copilot: console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=
# Public (exposed to the browser):
NEXT_PUBLIC_API_URL=http://localhost:3000

# Supabase -> Project Settings -> API. The anon / publishable key is public by
# design (Row Level Security protects the data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
